# Copy this file to .env.local for local development.
# Never commit .env.local or place private values in NEXT_PUBLIC_ variables.

# PostgreSQL on Aiven. Prefer hostname and certificate verification.
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DATABASE_SSL_CA_PATH=certs/aiven-ca.pem
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=60000
DB_POOL_CONNECTION_TIMEOUT_MS=15000

# Lead import limits. Uploaded files and mapped rows are processed server-side;
# original files are not persisted by the import workflow.
LEAD_IMPORT_MAX_FILE_BYTES=10000000
LEAD_IMPORT_MAX_ROWS=5000
LEAD_IMPORT_PREVIEW_ROWS=25

# Auth.js server-side secret. Generate a unique value for each environment.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=false

# Google OAuth for invite-only sign-in. Configure in Google Cloud Console.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google Drive receipts use the Auth.js Google OAuth client above (AUTH_GOOGLE_ID/SECRET) with the drive.file scope.
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Google Picker (to authorize an existing folder under drive.file): browser API key restricted to the Picker API + your origin,
# and the numeric Google Cloud project number.
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_MAX_FILE_BYTES=25000000
GOOGLE_DRIVE_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
# Optional when the target folder is in a shared drive.
GOOGLE_DRIVE_SHARED_DRIVE_ID=

# Meta Lead Ads integration. Leave unset until the Meta Business app, Page,
# lead form, webhook subscription, and Page access token are configured.
# Never use NEXT_PUBLIC_ variables for these values.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v25.0
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_DEFAULT_OWNER_ID=
META_DEFAULT_DEPARTMENT_ID=
META_WEBHOOK_MAX_BYTES=1000000
