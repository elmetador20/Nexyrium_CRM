+export default async function TargetsPage() { const actor = await requirePagePermission(PERMISSIONS.REPORTS_READ); const targets = await targetService.list(actor, {}); return <section className="space-y-6"><div><p className="text-sm text-zinc-500">Configurable departmental goals</p><h1 className="mt-1 text-2xl font-semibold">Targets</h1><p className="mt-2 text-sm text-zinc-500">Targets are goals, not actual revenue. Actuals are calculated in reports from authorized records.</p></div>{targets.length ? <div className="overflow-x-auto rounded-xl border bg-white dark:bg-zinc-950"><table className="data-table"><thead><tr><th>Department</th><th>Metric</th><th>Period</th><th>Target</th><th>Currency</th></tr></thead><tbody>{targets.map((target) => <tr key={target.id}><td>{target.departmentName}</td><td>{target.metricKey}</td><td>{target.periodStart} – {target.periodEnd}</td><td>{(target.currencyCode && target.targetMinor != null ? formatMoney(target.targetMinor,target.currencyCode) : target.targetCount)}</td><td>{target.currencyCode ?? "count"}</td></tr>)}</tbody></table></div> : <p className="panel text-sm text-zinc-500">No targets are configured for the selected scope.</p>}{can(actor, PERMISSIONS.REPORTS_MANAGE) ? <div className="panel"><h2 className="text-lg font-semibold">Add target</h2><p className="mt-1 text-sm text-zinc-500">Choose the month, department, and target amount.</p><div className="mt-5"><TargetForm /></div></div> : null}</section>; }
